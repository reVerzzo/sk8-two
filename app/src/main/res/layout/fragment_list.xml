<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_humo"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Spots de skate"
        android:textAppearance="@style/EstiloTituloSkate"
        android:textColor="@color/fondo_asfalto" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blanco_tarjeta"
                android:padding="18dp"
                android:text="Spot ejemplo: Escaleras del parque\nUbicacion: Centro\nDificultad: Media"
                android:textColor="@color/fondo_asfalto"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
